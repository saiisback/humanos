# Local development: start PostgreSQL, then use pnpm dev.
DATABASE_URL=postgresql://humanos:humanos@127.0.0.1:5432/humanos
TEST_DATABASE_URL=postgresql://humanos:humanos@127.0.0.1:5432/humanos
WEB_ORIGIN=http://localhost:5173
API_URL=http://127.0.0.1:3001
FLUE_URL=http://127.0.0.1:3002
DEMO_SERVICE_URL=http://127.0.0.1:3003
# Generate each separately: openssl rand -hex 32
FLUE_INTERNAL_SECRET=
DEMO_SERVICE_SECRET=
# https://developer.world.org : app, relying party, signing key; Proof of Human.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
# Official providers; backend only. Jev pinned jev-1.13.0, DeepSeek deepseek-flash.
DEEPSEEK_API_KEY=
JEV_API_KEY=
# ENSv2 Sepolia: see packages/contracts deployment guide; never Ethereum mainnet.
SEPOLIA_RPC_URL=
ENS_REGISTRAR_ADDRESS=
ENS_OPERATOR_PRIVATE_KEY=
# Per-mission scoped ENS signer derivation seed: 0x + openssl rand -hex 32.
ENS_AGENT_KEY_SEED=
ENS_CONFIRMATIONS=2
# Optional testnet gas funding per derived agent (wei); zero disables auto-funding.
ENS_AGENT_FUNDING_WEI=0
# Sepolia deployment inputs (contracts README).
DEPLOYER_PRIVATE_KEY=
HUMANOS_PARENT_LABEL=
# Compose-only private-network HTTP opt-in, never a model-selected hostname.
DEMO_SERVICE_ALLOW_HTTP_HOST=
# Compose database secret.
POSTGRES_PASSWORD=
