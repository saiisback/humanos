# Local development: start PostgreSQL, then use pnpm dev.
DATABASE_URL=postgresql://humanos:humanos@127.0.0.1:5432/humanos
TEST_DATABASE_URL=postgresql://humanos:humanos@127.0.0.1:5432/humanos
WEB_ORIGIN=http://localhost:5173
# Public browser SDK key; configure this origin in the JAW application domain allowlist.
VITE_JAW_API_KEY=
# Optional public HTTPS image URL shown by JAW during account connection.
VITE_JAW_APP_LOGO_URL=
API_URL=http://127.0.0.1:3001
FLUE_URL=http://127.0.0.1:3002
DEMO_SERVICE_URL=http://127.0.0.1:3003
# Generate each separately: openssl rand -hex 32
FLUE_INTERNAL_SECRET=
DEMO_SERVICE_SECRET=
# https://developer.world.org : app, relying party, signing key; Proof of Human.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
# Preferred: one server-only OpenCode Zen key for DeepSeek, Jev, and Flue.
OPENCODE_API_KEY=
# Real workflow connectors, server-only. Bind credentials to the full HumanOS
# account ID (chainId:address), not an unqualified wallet address.
CONNECTOR_ACCOUNT_ID=
BRAVE_SEARCH_API_KEY=
RESEND_API_KEY=
# Must be a sender authorized by the Resend account.
RESEND_FROM_EMAIL=
# Optional local browser fallback (off unless set to local-chromium). Uses a
# dedicated HumanOS Chromium profile, never your everyday browser. Only audited
# site recipes in source can be opened; none are installed by default.
HUMANOS_BROWSER_DRIVER=
HUMANOS_BROWSER_PROFILE_DIR=
HUMANOS_BROWSER_HEADLESS=true
# Optional direct-provider fallback when OPENCODE_API_KEY is absent.
DEEPSEEK_API_KEY=
JEV_API_KEY=
# ENSv2 Sepolia: see packages/contracts deployment guide; never Ethereum mainnet.
# Backend-only RPC used for EOA, ERC-1271 and ERC-6492 SIWE signature checks.
SEPOLIA_RPC_URL=
ENS_REGISTRAR_ADDRESS=
ENS_OPERATOR_PRIVATE_KEY=
# Per-mission scoped ENS signer derivation seed: 0x + openssl rand -hex 32.
ENS_AGENT_KEY_SEED=
ENS_CONFIRMATIONS=2
# Optional testnet gas funding per derived agent (wei); zero disables auto-funding.
ENS_AGENT_FUNDING_WEI=0
# Sepolia deployment inputs (contracts README).
DEPLOYER_PRIVATE_KEY=
HUMANOS_PARENT_LABEL=
# Compose-only private-network HTTP opt-in, never a model-selected hostname.
DEMO_SERVICE_ALLOW_HTTP_HOST=
# Compose database secret.
POSTGRES_PASSWORD=
